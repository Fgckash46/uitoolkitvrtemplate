<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Resources/MainMenu/MainMenuUI.uss?fileID=7433441132597879392&amp;guid=47f555954a88a8a49b216c40a2189562&amp;type=3#MainMenuUI"/>
    <ui:VisualElement class="menu-container">
        <ui:VisualElement class="tab-header" style="flex-direction: row;">
            <ui:Button text="CAMPAIGN" class="tab-btn active tab-button--selected"/>
            <ui:Button text="ENDLESS" class="tab-btn"/>
            <ui:Button text="MULTIPLAYER" class="tab-btn"/>
        </ui:VisualElement>
        <ui:VisualElement class="main-panel">
            <ui:VisualElement class="content-row" style="flex-direction: row; justify-content: space-evenly;">
                <ui:VisualElement class="tutorial-card" style="background-image: url(&quot;project://database/Assets/Editor%20Default%20Resources/Firebase/fb_auth_dark.png?fileID=2800000&amp;guid=3a9e1ef6287664c389bb09e2ac1b23b7&amp;type=3#fb_auth_dark&quot;);">
                    <ui:Label text="Training Protocol" class="title-text"/>
                    <ui:Label text="Master the gravity-defying mechanics and weapon systems of the Astra core." class="body-text"/>
                    <ui:Button text="▶ PLAY TUTORIAL" class="play-button"/>
                </ui:VisualElement>
                <ui:VisualElement class="settings-column">
                    <ui:Label text="SELECT DIFFICULTY" class="section-label"/>
                    <ui:VisualElement class="button-group" style="flex-direction: row;">
                        <ui:Button text="EASY" class="chip-btn unity-button"/>
                        <ui:Button text="NORMAL" class="chip-btn unity-button active"/>
                        <ui:Button text="HARD" class="chip-btn unity-button"/>
                    </ui:VisualElement>
                    <ui:Label text="SELECT DIFFICULTY" class="section-label"/>
                    <ui:RadioButtonGroup class="horizontal-group">
                        <ui:RadioButton label="EASY" class="chip-radio">
                            <ui:Label text="EASY" class="unity-radio-button__label"/>
                        </ui:RadioButton>
                        <ui:RadioButton label="NORMAL" value="true" class="chip-radio">
                            <ui:Label text="NORMAL" class="unity-radio-button__label"/>
                        </ui:RadioButton>
                        <ui:RadioButton label="HARD" class="chip-radio">
                            <ui:Label text="HARD" class="unity-radio-button__label"/>
                        </ui:RadioButton>
                    </ui:RadioButtonGroup>
                    <ui:Label text="REGION &amp; LANGUAGE" class="section-label"/>
                    <ui:DropdownField label="" name="lang-dropdown" class="custom-dropdown"/>
                    <ui:VisualElement class="status-box">
                        <ui:Label text="SYSTEM STATUS" class="status-title"/>
                        <ui:Label text="Syncing with US-EAST-1. Ping: 24ms" class="status-text"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Button text="START SESSION" class="start-session-btn"/>
            <ui:Label text="PRESS SPACE TO INITIATE LINK" class="footer-hint"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
