:root {
    --sharp-red: #E60012;
    --sharp-red-hover: #B3000E;
    --sharp-red-active: #80000A;
    --bg-light: #F4F4F4;
    --card-white: #FFFFFF;
    --border-gray: #D1D1D1;
    --text-black: #333333;
    --text-muted: #666666;
    --shadow-soft: rgba(0, 0, 0, 0.1);

    --bg-gradient-start: #e2e8f0;
    --bg-gradient-end: #ffffff;
    --glass-bg: rgba(255, 255, 255, 0.6);
    --glass-border: rgba(255, 255, 255, 0.8);
}

.container {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    background-color: var(--bg-gradient-start);
}

.card, .dialog-card {
    background-color: var(--card-white);
    border-width: 1px;
    border-color: var(--border-gray);
    border-radius: 8px; /* 角丸を控えめに */
    padding: 32px;
    align-items: center;
    /* 家電の操作パネル風の影 */
    border-bottom-width: 3px; 
}

.card {
    min-width: 320px;
}

.label-title {
    color: var(--sharp-red); /* タイトルに赤を使いアクセントに */
    font-size: 13px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.label-count {
    color: var(--text-black);
    font-size: 72px;
    -unity-font-style: bold;
    margin: 16px 0;
}

.modern-button {
    background-color: var(--sharp-red);
    color: white;
    border-radius: 4px; /* よりシャープな角 */
    padding: 14px 24px;
    font-size: 16px;
    border-width: 0;
    transition-duration: 0.1s;
    width: 100%;
    margin-top: 12px;
    -unity-font-style: bold;
}

.modern-button:hover {
    background-color: var(--sharp-red-hover);
    scale: 1.0; /* 浮ついた動きは抑える */
}

.modern-button:active {
    background-color: var(--sharp-red-active);
    border-top-width: 2px; /* 押し込んだような視覚効果 */
}

.overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.5); /* 遮断しすぎない黒 */
    justify-content: center;
    align-items: center;
}

.hidden {
    display: none;
    opacity: 0;
}

.dialog-text {
    color: var(--text-black);
    font-size: 18px;
    margin-bottom: 24px;
    -unity-text-align: middle-center;
}

.dialog-button-row {
    flex-direction: row;
    justify-content: space-between;
    width: 100%;
}

.btn-cancel {
    background-color: #999999;
    width: 45%;
}

.btn-cancel:hover {
    background-color: #777777;
}

.btn-danger {
    background-color: var(--sharp-red);
    width: 45%;
}

.dialog-instance {
    position: absolute;
    right: 0;
    left: 0;
    top: 0;
    bottom: 0;
}